# Local development only. Copy to .env and choose a unique local password.
APP_ENV=development
POSTGRES_DB=finguard_dev
POSTGRES_USER=finguard_dev
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://finguard_dev:replace_with_a_local_password@localhost:5432/finguard_dev

# Local HTTP only; production must use Secure cookies and HTTPS origins.
LOCAL_INSECURE_COOKIE=true
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_HOSTS=127.0.0.1,localhost
# Set JWT_SECRET securely for persistent sessions or multiple workers.
# JWT_SECRET=

# Event configuration; broker is optional for the API, required for dispatcher use.
FINGUARD_KAFKA_BOOTSTRAP_SERVERS=
FINGUARD_KAFKA_CLIENT_ID=finguard-outbox
FINGUARD_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Optional online feature projection; set only for a local, access-restricted Redis.
FINGUARD_REDIS_URL=redis://127.0.0.1:6379/0
FINGUARD_FEATURE_FRESHNESS_SECONDS=120
FINGUARD_FEATURE_PROJECTION_VERSION=v1
